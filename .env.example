# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg://taskboard:taskboard@localhost:5432/taskboard

# ── Application ───────────────────────────────────────────────────────────────
# Backend port (default: 8000)
BACKEND_PORT=8000
# Frontend port (default: 3000)
FRONTEND_PORT=3000

# ── GitHub Actions Secrets (set in repo Settings → Secrets) ──────────────────
# Kubernetes config for deployment job
# KUBECONFIG=<base64-encoded kubeconfig>

# ── AWS (for Terraform — never commit real values) ────────────────────────────
# AWS_ACCESS_KEY_ID=<your-access-key>
# AWS_SECRET_ACCESS_KEY=<your-secret-key>
# AWS_REGION=ap-south-1
